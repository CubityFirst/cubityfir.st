{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubityfirst",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cubityfir.st", "custom_domain": true },
    { "pattern": "michaelburr.co.uk", "custom_domain": true }
  ],
  "previews": {}
}
